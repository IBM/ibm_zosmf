EXAMPLES = r"""
- name: sample of deploying software to a target system using original format
  hosts: sampleHost
  gather_facts: no
  collections:
    - ibm.ibm_zosmf

  tasks:
    - name: Set deployment configuration using original format
      ansible.builtin.set_fact:
        deployment_configuration:
          datasets:
            - if: "dsname=*.**"
              then:
                - property: "dsname"
                  from: "*.**"
                  to: "*.HLQ.**"
                - property: "storclas"
                  to: "STANDARD"
    
    - include_role:
        name: zmf_swmgmt_deployment

- name: sample of deploying software using simplified deployment_configuration_datasets format
  hosts: sampleHost
  gather_facts: no
  collections:
    - ibm.ibm_zosmf

  tasks:
    - name: Set deployment configuration using data set HLQ and storage class
      ansible.builtin.set_fact:
        deployment_hlq: HLQ
        deployment_storage_class: STANDARD
    
    - include_role:
        name: zmf_swmgmt_deployment

"""

